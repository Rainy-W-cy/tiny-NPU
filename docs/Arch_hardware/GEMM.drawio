        <mxCell id="6hrt9bw7DJHQb-f-q0O3-639" value="&lt;p&gt;&lt;strong&gt;&lt;font face=&quot;Times New Roman&quot;&gt;C tile 0：C[0:15, 0:15]&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;pre&gt;&lt;code&gt;&lt;font face=&quot;Times New Roman&quot;&gt;m0 n0 k0:&lt;br&gt;  A[0:15, 0:15]   * B[0:15, 0:15]&lt;br&gt;  sa_acc -&amp;gt; ACC SRAM&lt;br&gt;&lt;br&gt;m0 n0 k1:&lt;br&gt;  A[0:15, 16:31]  * B[16:31, 0:15]&lt;br&gt;  ACC SRAM old + sa_acc -&amp;gt; ACC SRAM&lt;br&gt;&lt;br&gt;m0 n0 k2:&lt;br&gt;  A[0:15, 32:47]  * B[32:47, 0:15]&lt;br&gt;  ACC SRAM old + sa_acc -&amp;gt; ACC SRAM&lt;br&gt;&lt;br&gt;m0 n0 k3:&lt;br&gt;  A[0:15, 48:63]  * B[48:63, 0:15]&lt;br&gt;  ACC SRAM old + sa_acc -&amp;gt; requant -&amp;gt; output SRAM C[0:15, 0:15]&lt;/font&gt;&lt;/code&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-700" y="1446" width="440" height="290" as="geometry" />
