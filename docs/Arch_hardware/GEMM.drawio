        <mxCell id="6hrt9bw7DJHQb-f-q0O3-638" value="&lt;pre&gt;&lt;code&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;&lt;b&gt;m0 n0 k0&lt;br&gt;m0 n0 k1&lt;br&gt;m0 n0 k2&lt;br&gt;m0 n0 k3&lt;br&gt;&lt;br&gt;m0 n1 k0&lt;br&gt;m0 n1 k1&lt;br&gt;m0 n1 k2&lt;br&gt;m0 n1 k3&lt;br&gt;&lt;br&gt;m1 n0 k0&lt;br&gt;m1 n0 k1&lt;br&gt;m1 n0 k2&lt;br&gt;m1 n0 k3&lt;br&gt;&lt;br&gt;m1 n1 k0&lt;br&gt;m1 n1 k1&lt;br&gt;m1 n1 k2&lt;br&gt;m1 n1 k3&lt;/b&gt;&lt;/font&gt;&lt;/code&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
