        <mxCell id="jTa1Hz44jgc9tCbQt74q-1" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;acc_sram&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;gemm k tile累加器&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="-800" y="6320" width="180" height="360" as="geometry" />
        </mxCell>
        <mxCell id="jTa1Hz44jgc9tCbQt74q-2" value="&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;&lt;font style=&quot;font-size: 16px;&quot; face=&quot;Times New Roman&quot;&gt;深度 = 256&lt;/font&gt;&lt;/code&gt;&lt;/pre&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;Times New Roman&quot;&gt;地址位宽 = log2(256) = 8 bit&lt;br/&gt;地址范围 = 0 到 255&lt;/font&gt;&lt;/code&gt;&lt;/pre&gt;&lt;font style=&quot;font-size: 16px;&quot; face=&quot;Times New Roman&quot;&gt;数据位宽 = 32 bit&lt;br&gt;容量 = 256 * 4B = 1024B&lt;br&gt;Consumer = GEMM Controller&lt;/font&gt;&lt;/code&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-560" y="6290" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="jTa1Hz44jgc9tCbQt74q-3" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;ACC SRAM 保存 GEMM 分块计算的 32-bit 累加结果。&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-560" y="6460" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="jTa1Hz44jgc9tCbQt74q-4" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;C++ 没有直接装载或读取 ACC SRAM 的接口。&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-560" y="6480" width="330" height="40" as="geometry" />
