        <mxCell id="Jnxdh4wxM1wv92xRU7Bc-130" value="&lt;b&gt;r_silu_mode&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
