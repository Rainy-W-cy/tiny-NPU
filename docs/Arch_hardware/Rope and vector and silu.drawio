        <mxCell id="V9CU6IVP-RjPXobx_7mz-3" value="旋转位置编码数学理论（所有layer共享）" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="80" width="130" height="30" as="geometry" />
