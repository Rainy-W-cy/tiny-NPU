        <mxCell id="V9CU6IVP-RjPXobx_7mz-5" value="\(x=&#xa;\begin{bmatrix}&#xa;x_0\\&#xa;x_1&#xa;\end{bmatrix}\)" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="140" width="60" height="50" as="geometry" />
        </mxCell>
        <mxCell id="V9CU6IVP-RjPXobx_7mz-6" value="对于二维向量：" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="50" y="110" width="90" height="20" as="geometry" />
        </mxCell>
        <mxCell id="V9CU6IVP-RjPXobx_7mz-7" value="\(R(\theta)x=&#xa;\begin{bmatrix}&#xa;\cos\theta &amp;amp; -\sin\theta\\&#xa;\sin\theta &amp;amp; \cos\theta&#xa;\end{bmatrix}&#xa;\begin{bmatrix}&#xa;x_0\\&#xa;x_1&#xa;\end{bmatrix}\)" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="50" y="220" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="V9CU6IVP-RjPXobx_7mz-8" value="旋转角度 &lt;span&gt;\(\theta\)&lt;/span&gt; 后：" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
