        <mxCell id="V9CU6IVP-RjPXobx_7mz-10" value="&lt;span&gt;\[&#xa;x&#39;_0=x_0\cos\theta-x_1\sin\theta&#xa;\]&lt;/span&gt;&lt;span&gt;\[&#xa;x&#39;_1=x_0\sin\theta+x_1\cos\theta&#xa;\]&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
