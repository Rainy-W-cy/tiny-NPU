        <mxCell id="Jnxdh4wxM1wv92xRU7Bc-135" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;strokeColor=#B3B3B3;" vertex="1" parent="1">
