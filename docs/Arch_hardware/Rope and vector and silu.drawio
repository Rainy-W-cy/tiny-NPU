        </mxCell>
        <mxCell id="Jnxdh4wxM1wv92xRU7Bc-136" value="&lt;b&gt;4*S*FFN dim&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="730" y="1680" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Jnxdh4wxM1wv92xRU7Bc-137" value="&lt;p&gt;&lt;b&gt;SiLU 定义为：&lt;/b&gt;&lt;/p&gt;&lt;span&gt;\[&lt;br&gt;SiLU(x)=x\cdot \sigma(x)&lt;br&gt;\]&lt;/span&gt;&lt;p&gt;其中 Sigmoid 为：&lt;/p&gt;&lt;span&gt;\[&lt;br&gt;\sigma(x)=\frac{1}{1+e^{-x}}&lt;br&gt;\]&lt;/span&gt;&lt;p&gt;所以：&lt;/p&gt;&lt;span&gt;\[&lt;br&gt;SiLU(x)=\frac{x}{1+e^{-x}}&lt;br&gt;\]&lt;/span&gt;&lt;p&gt;它的基本特性是：&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;code dir=&quot;ltr&quot;&gt;x=0&lt;/code&gt; 时输出为 0；&lt;/li&gt;&lt;li&gt;正数较大时，输出逐渐接近 &lt;code dir=&quot;ltr&quot;&gt;x&lt;/code&gt;；&lt;/li&gt;&lt;li&gt;负数不会全部变成 0，而是保留较小的负值；&lt;/li&gt;&lt;li&gt;函数连续且平滑。&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="25" y="1540" width="310" height="380" as="geometry" />
        </mxCell>
        <mxCell id="Jnxdh4wxM1wv92xRU7Bc-139" value="&lt;p&gt;其作用同样是平滑地控制输入通过程度：&lt;/p&gt;&lt;ul&gt;&lt;li&gt;较大的正数近似原样通过；&lt;/li&gt;&lt;li&gt;较大的负数逐渐趋近于 0；&lt;/li&gt;&lt;li&gt;&lt;code dir=&quot;ltr&quot;&gt;x=0&lt;/code&gt; 时输出为 0；&lt;/li&gt;&lt;li&gt;与 ReLU 不同，负数区域仍保留少量输出&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="25" y="1890" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="Jnxdh4wxM1wv92xRU7Bc-140" value="\(addr=&#xa;\begin{cases}&#xa;q_{in}, &amp;amp; q_{in}\geq0\\&#xa;q_{in}+256, &amp;amp; q_{in}&amp;lt;0&#xa;\end{cases}\)" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1250" y="1870" width="182.37" height="50" as="geometry" />
        </mxCell>
        <mxCell id="Jnxdh4wxM1wv92xRU7Bc-141" value="-B=~B+1;补码编码" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1445" y="1890" width="105" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Jnxdh4wxM1wv92xRU7Bc-142" value="Q3.5" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1250" y="1750" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Jnxdh4wxM1wv92xRU7Bc-143" value="Q3.5" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1560" y="1760" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Jnxdh4wxM1wv92xRU7Bc-145" value="&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;span&gt;\[&lt;br&gt;\boxed{&lt;br&gt;\operatorname{GELU}(x)&lt;br&gt;\approx&lt;br&gt;\frac{x}{2}&lt;br&gt;\left[&lt;br&gt;1+&lt;br&gt;\tanh&lt;br&gt;\left(&lt;br&gt;\sqrt{\frac{2}{\pi}}&lt;br&gt;\left(&lt;br&gt;x+0.044715x^3&lt;br&gt;\right)&lt;br&gt;\right)&lt;br&gt;\right]&lt;br&gt;}&lt;br&gt;\]&lt;/span&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="15" y="1790" width="310" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
